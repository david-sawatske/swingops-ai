{
  "name": "@swingops/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API for SwingOps AI workflow, intake, review, model-call, and tool-call operations.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:db:prepare": "tsx src/test/prepare-test-database.ts",
    "pretest": "pnpm test:db:prepare",
    "test": "vitest run --no-file-parallelism",
    "config:check": "tsx src/config/check-env.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "mcp:dev": "tsx src/mcp/server.ts",
    "mcp:start": "node dist/mcp/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.11.2",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
