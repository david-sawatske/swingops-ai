# Required local database. Docker Compose publishes PostgreSQL on host port 5433.
DATABASE_URL="postgresql://swingops:swingops@localhost:5433/swingops_ai?schema=public"
TEST_DATABASE_URL="postgresql://swingops:swingops@localhost:5433/swingops_ai_test?schema=public"

# API server and browser origin.
API_HOST="0.0.0.0"
API_PORT="4000"
LOG_LEVEL="info"
WEB_ORIGIN="http://localhost:5173"

# Operator maintenance prunes only LIVE_DEMO rows older than this window.
# SEEDED_BASELINE and GOLDEN_DEMONSTRATION data are never retention targets.
LIVE_DEMO_RETENTION_DAYS="14"

# Optional in-process maintenance schedule. Local development leaves this
# disabled; the always-on portfolio deployment runs it once every 24 hours.
ADMIN_OPS_MAINTENANCE_INTERVAL_HOURS="0"

# Per-client-IP request limits (0 disables a limit). Workflow routes run
# workflows, evaluations, or paid model calls and get the tighter limit.
RATE_LIMIT_MAX_PER_MINUTE="300"
WORKFLOW_RATE_LIMIT_MAX_PER_MINUTE="10"

# Reverse-proxy hops to trust for the client IP. Keep 0 locally; set it to the
# number of proxies in front of the API in production.
TRUST_PROXY_HOPS="0"

# The demo knowledge ingest route deletes and rebuilds the knowledge corpus.
KNOWLEDGE_INGEST_ROUTE_ENABLED="true"

# Real provider calls are opt-in. The deterministic/mock path works without keys.
ENABLE_REAL_MODEL_CALLS="false"

# Bound each provider attempt and the complete provider fallback sequence.
MODEL_PROVIDER_ATTEMPT_TIMEOUT_MS="10000"
MODEL_PROVIDER_WORKFLOW_TIMEOUT_MS="25000"

# Configure one or more providers before setting ENABLE_REAL_MODEL_CALLS=true.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1-mini"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT=""
# AZURE_OPENAI_API_VERSION="2024-10-21"
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2"
